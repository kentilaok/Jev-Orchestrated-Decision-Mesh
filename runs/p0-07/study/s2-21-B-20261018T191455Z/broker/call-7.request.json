        "hash": "cbec55952af3d511e29326c8b81b2e938bf841267a6417a8c4c7c55dc3621c70",
        "text": "distill_lessons runs on the records below and skill_name is called on the resulting lesson. What exact string does skill_name return?"
      },
      {
        "id": "fields",
        "hash": "454957e107a70fe479be9b913c547f8c4e5d69583ba7dbc0a6078ff943864724",
        "text": "        verified = [item for item in items if item.get(\"verified_recovery\")]\n        if not verified:\n            continue\n        unit_id = str(verified[0].get(\"unit_id\") or \"unknown\")\n        project_scope = str(verified[0].get(\"project_scope\") or \"unscoped\")"
      },
      {
        "id": "code",
        "hash": "12ed3c1ce7b77219233bf69b3cd758adaab4442a301454de52b3d3cc1abc74db",
        "text": "def skill_name(lesson: dict) -> str:\n    scope = str(lesson.get(\"project_scope\") or \"unscoped\").lower().replace(\"_\", \"-\")\n    unit = str(lesson.get(\"unit_id\") or \"recovery\").lower().replace(\"_\", \"-\")\n    signature = str(lesson.get(\"signature\") or \"unknown\")[:8].lower()\n    base = \"cidm-\" + scope + \"-\" + unit + \"-\" + signature\n    return \"\".join(ch for ch in base if ch.isalnum() or ch == \"-\")[:64]"
      },
      {
