    "evidence": [
      {
        "id": "request",
        "hash": "d0690274d26daf298760fe07f53e980da841d5eae69f90131d539c6b5d9c455a",
        "text": "What value does audit_permit_ledger (no journal) report for \"receipted\" on this ledger? Where sources disagree, the current code is authoritative."
      },
      {
        "id": "code",
        "hash": "0bd048275b0bb1e158f0744be3d6641bfda3de1385a16f8d56b3f304b0af7221",
        "text": "    issues, issued, consumed, receipted = [], {}, set(), set()\n    ...\n    for event in events:\n        kind, pid = event.get(\"kind\"), event.get(\"permit_id\")\n        if kind == \"permit_issued\":\n            ...\n            issued[pid] = event\n            ...\n        elif kind == \"permit_consumed\":\n            if pid not in issued:\n                issues.append(\"consumed_without_issue:\" + str(pid))\n            elif pid in consumed:\n                issues.append(\"double_consumption:\" + str(pid))\n            elif issued[pid].get(\"scope_hash\") != event.get(\"scope_hash\"):\n                issues.append(\"consumed_scope_mismatch:\" + str(pid))\n            consumed.add(pid)\n        elif kind == \"permit_receipt\":\n            if pid not in consumed:\n                issues.append(\"receipt_without_consumption:\" + str(pid))\n            receipted.add(pid)\n    missing = sorted(consumed - receipted)\n    issues.extend(\"consumed_without_receipt:\" + pid for pid in missing)\n    return {\"valid\": not issues, \"issues\": issues, \"issued\": len(issued),\n            \"consumed\": len(consumed), \"receipted\": len(receipted),\n            \"unused\": sorted(set(issued) - consumed)}"
      },
      {
        "id": "ledger",
        "hash": "45f35dbff1a550fee76bf9b5c9b40ba86de757185f4ac88e300068de3f178c10",
        "text": "{\"kind\": \"permit_issued\", \"permit_id\": \"p-1\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_consumed\", \"permit_id\": \"p-1\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-1\"}\n{\"kind\": \"permit_issued\", \"permit_id\": \"p-2\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_consumed\", \"permit_id\": \"p-2\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-2\"}\n{\"kind\": \"permit_issued\", \"permit_id\": \"p-3\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_consumed\", \"permit_id\": \"p-3\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-3\"}\n{\"kind\": \"permit_issued\", \"permit_id\": \"p-4\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_consumed\", \"permit_id\": \"p-4\", \"scope_hash\": \"s\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-4\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-x1\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-x2\"}\n{\"kind\": \"permit_receipt\", \"permit_id\": \"p-x3\"}"
      },
      {
        "id": "doc",
        "hash": "5cf9b234a7085110eae4ffcec0cee84597d88d3887be1b8b55a07917aec8cd98",
        "text": "\"receipted\" counts only receipts that match a consumed permit; orphan receipts are reported as issues and excluded from the count."
