+"""Candidate-only behaviour: instrumentation fixes (default on) and flagged policies (default off)."""
+import copy
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
+import jev_decide  # noqa: E402
+from atomic_mesh import MeshError, packed  # noqa: E402
+from audit_network import audit  # noqa: E402
+from checked_network import CheckedNetwork  # noqa: E402
+from codex_cli_adapter import CodexCliAdapter, CodexCliError  # noqa: E402
+from config import RunConfig  # noqa: E402
+from native_transition_broker import NativeTransitionBroker  # noqa: E402
+from network_run import DemoPipeline, fake_check  # noqa: E402
+from transport import Gateway  # noqa: E402
+
+TASK = json.loads((Path(__file__).resolve().parents[1] / 'examples/production-records.json').read_text())
+SPEC = {'goal': 'Write a source-supported release checklist for the service.', 'context': '',
+        'sources': {'policy': {'title': 'Release policy', 'text': 'Each release needs tests, rollback and an owner.'}},
+        'active_project': False, 'unresolved_stages': [], 'classification': None}
+
+
+class Codex:
+    def __init__(self, unresolved_unit=None):
+        self.unresolved_unit = unresolved_unit
+
+    def run(self, model, effort, prompt, schema, workspace):
+        data = json.loads(prompt)
+        if data.get('role') == 'separate Sol-high checker':
+            artifact = {'verdict': 'pass', 'failed_criteria': [], 'reason': 'ok', 'missing_evidence': []}
+        else:
+            unit = data.get('unit', {}).get('id')
+            artifact = {'text': 'Result.', 'data': {'summary': 'x', 'claims': [],
+                                                    'unresolved': ['gap'] if unit == self.unresolved_unit else [],
+                                                    'parent_hashes': data['required_parent_hashes'],
+                                                    'source_hashes': data['required_source_hashes']},
+                        'source_ids': list(data['sources']), 'five_scores': [4] * 5, 'self_probability': None}
+        return {'artifact': artifact, 'usage': {'input_tokens': 10, 'output_tokens': 5}, 'requested_model': model,
+                'requested_effort': effort, 'actual_model': None, 'actual_effort': None,
+                'identity_verification': 'requested_only', 'events': []}
+
+
+class Jev:
+    def __init__(self):
+        self.phases = []
+
+    def __call__(self, phase, options, state):
+        self.phases.append(phase)
+        if phase == 'project_route':
+            choice = 'five_unit'
+        elif phase == 'authorize_unit':
+            choice = 'compute' if 'compute' in options else 'luna_low'
+        else:
+            choice = 'forward' if 'forward' in options else ('repair' if 'repair' in options else 'stop')
+        return {'choice': choice, 'model': 'typesafe/jev-1.13-20260917', 'live': True,
+                'usage': {'input_tokens': 10, 'output_tokens': 1, 'cost': 0.0000005}}
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.folder = Path(tmp.name)
+
+
+class InstrumentationFixes(Base):
+    def test_jev_receipt_keeps_generation_id_and_timestamps_and_refuses_overwrite(self):
+        request = {'model': 'typesafe/jev-1.13', 'state': {'x': 1},
+                   'questions': {'next': {'type': 'choice', 'instructions': 'Pick.', 'criteria': {'a': 'A', 'b': 'B'}}}}
+        req, out = self.folder / 'r.json', self.folder / 'o.json'
+        req.write_text(json.dumps(request))
+        response = {'id': 'gen-dec-42', 'model': 'typesafe/jev-1.13-20260917', 'provider': 'TypeSafe',
+                    'usage': {'input_tokens': 5, 'output_tokens': 1, 'cost': 0.00000021},
+                    'answers': {'next': {'type': 'choice', 'choice': 'a', 'confidence': 0.9,
+                                         'probabilities': {'a': 0.95, 'b': 0.05}}}}
+        with patch.object(jev_decide, 'call_api', return_value=(response, 12.0)), \
+                patch.dict('os.environ', {'OPENROUTER_API_KEY': 'k'}):
+            self.assertEqual(jev_decide.main(['--request', str(req), '--out', str(out)]), 0)
+            receipt = json.loads(out.read_text())
+            self.assertEqual(receipt['provider_request_id'], 'gen-dec-42')
+            self.assertTrue(receipt['started_at'].endswith('Z') and receipt['ended_at'].endswith('Z'))
+            self.assertEqual(jev_decide.main(['--request', str(req), '--out', str(out)]), 2)
+            self.assertEqual(json.loads(out.read_text()), receipt)   # first receipt preserved
+
+    def test_gateway_event_has_generation_id_and_timestamps(self):
+        gateway = Gateway(self.folder, RunConfig())
+        response = {'id': 'gen-dec-7', 'model': 'typesafe/jev-1.13-20260917', 'provider': 'TypeSafe',
+                    'usage': {'input_tokens': 10, 'output_tokens': 2, 'cost': 0.00000042},
+                    'answers': {'next': {'type': 'choice', 'choice': 'compute', 'confidence': 0.96,
+                                         'probabilities': {'compute': 0.98, 'stop': 0.02}}}}
+        with patch.object(gateway, '_request', return_value=response):
+            gateway.network_judge('authorize_unit', {'compute': 'Run code.', 'stop': 'Stop.'}, {'x': 1})
+        event = gateway.calls[-1]
