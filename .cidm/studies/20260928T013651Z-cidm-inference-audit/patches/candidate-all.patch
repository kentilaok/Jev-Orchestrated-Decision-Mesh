+        result['policy_flags'] = {'skip_vacuous_gates': False}
+        self.assertIn('unauthorized_policy_decision', audit(result)['issues'])
+
+    def test_cited_only_state_omits_uncited_text_with_retrieval_pointer(self):
+        seen = []
+
+        def decide(phase, options, state):
+            seen.append(state)
+            if phase == 'authorize_unit':
+                return {'choice': 'compute' if 'compute' in options else 'luna_low', 'live': False}
+            return {'choice': 'forward', 'live': False}
+        pipe = DemoPipeline(TASK)
+        sources = {'records': {'title': 'r', 'text': packed(TASK)}, 'extra': {'title': 'e', 'text': 'unrelated note'}}
+        CheckedNetwork(TASK['goal'], sources, decide, pipe.produce, fake_check, pipe.validate, simulation=True,
+                       jev_evidence_mode='cited_only').run()
+        after = [s for s in seen if 'candidate' in s]
+        self.assertTrue(after and all([e['id'] for e in s['evidence']] == ['records'] for s in after))
+        self.assertTrue(all(s['evidence_omitted'][0]['id'] == 'extra' for s in after))
