+class FlaggedPolicies(Base):
+    def network(self, judge, **kw):
+        pipe = DemoPipeline(TASK)
+        return CheckedNetwork(TASK['goal'], {'records': {'title': 'r', 'text': packed(TASK)}}, judge, pipe.produce,
+                              fake_check, pipe.validate, simulation=True, **kw)
+
+    def judge(self, calls):
+        def decide(phase, options, state):
+            calls.append((phase, state['unit']['id']))
+            if phase == 'authorize_unit':
+                return {'choice': 'compute' if 'compute' in options else 'luna_low', 'live': False}
+            return {'choice': 'forward', 'live': False}
+        return decide
+
+    def test_defaults_are_the_installed_protocol(self):
+        calls = []
+        result = self.network(self.judge(calls)).run()
+        self.assertEqual(result['status'], 'complete')
+        self.assertEqual(len(calls), 10)
+        self.assertNotIn('candidate_flags', self.network(self.judge([])).policy)
+
+    def test_skip_vacuous_gates_removes_four_jev_calls_and_audits(self):
+        calls = []
+        result = self.network(self.judge(calls), skip_vacuous_gates=True).run()
+        self.assertEqual(result['status'], 'complete')
+        self.assertEqual(len(calls), 6)
+        self.assertFalse(any(unit in ('input', 'hidden2') for _, unit in calls))
+        policy = [e for e in result['events'] if e['kind'] == 'policy_decision']
+        self.assertEqual(len(policy), 4)
+        self.assertTrue(audit(result)['valid'], audit(result)['issues'])
+
+    def test_skip_returns_failed_deterministic_result_to_jev(self):
+        calls = []
+        net = self.network(self.judge(calls), skip_vacuous_gates=True)
+        original = net.validator
+        net.validator = lambda unit, cand, parents: ({**original(unit, cand, parents), 'forced': False}
+                                                      if unit.id == 'input' else original(unit, cand, parents))
+        net.run()
+        self.assertIn(('after_worker', 'input'), calls)
+
+    def test_policy_decision_without_flag_is_rejected_by_audit(self):
