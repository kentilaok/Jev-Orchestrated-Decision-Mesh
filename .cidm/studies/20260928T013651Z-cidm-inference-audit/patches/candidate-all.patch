+        skip = NativeTransitionBroker(Codex(), skip_jev, RunConfig(), self.folder / 'b', skip_vacuous_gates=True).run(SPEC)
+        self.assertEqual((base['status'], skip['status']), ('complete', 'complete'))
+        self.assertEqual(len(base_jev.phases) - len(skip_jev.phases), 2)
+        self.assertTrue(skip['native_audit']['valid'], skip['native_audit'])
