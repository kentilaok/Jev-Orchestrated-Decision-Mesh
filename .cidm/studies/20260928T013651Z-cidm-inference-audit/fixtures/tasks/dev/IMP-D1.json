  "sources": {
    "module": {
      "text": "def parse_duration(text):\n    total = 0\n    number = ''\n    for ch in text:\n        if ch.isdigit():\n            number += ch\n        elif ch == 'h':\n            total += int(number) * 60\n            number = ''\n        elif ch == 'm':\n            total += int(number)\n            number = ''\n    return total * 60\n",
      "title": "duration.py"
    }
  },
